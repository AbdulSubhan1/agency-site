# Which brand this deployment shows: "us" (US market) or "asia" (UAE and Pakistan). Each Vercel project sets its
# own; the default for local work is "us". After changing it, rebuild: the brand is fixed per build.
BRAND=us

# The site's public address, for links in sitemaps and shared previews. Vercel's production URL is used if unset.
# SITE_URL=https://example.vercel.app

# Where enquiries go: AgencyDesk's address and this brand's website secret (the same value as WEBSITE_SECRET_US or
# WEBSITE_SECRET_ASIA in AgencyDesk; openssl rand -hex 32). Without them the form says it can't send right now.
AGENCYDESK_API_URL=http://localhost:3071
WEBSITE_SECRET=

# Optional: a booking page (e.g. a free Cal.com link) shown after a US enquiry is sent.
# BOOKING_URL=

# Optional: Pulse monitoring. The project id must be registered in the monitor first (src/lib/projects.ts there);
# the token lets the server report its calls to the CRM.
# NEXT_PUBLIC_PULSE_PROJECT=agency-us
# MONITOR_LOG_TOKEN=
